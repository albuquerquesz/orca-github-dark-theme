{
  "manifestVersion": 2,
  "id": "github-dark-theme",
  "name": "GitHub Dark for Orca",
  "version": "1.0.1",
  "execution": "data",
  "description": "A GitHub Dark theme for Orca with a lighter neutral gray interface and matching terminal colors.",
  "license": "MIT",
  "repository": "https://github.com/albuquerquesz/orca-github-dark-theme",
  "engines": {
    "orca": ">=1.4.246"
  },
  "contributes": {
    "themes": [
      {
        "id": "github-dark",
        "title": "GitHub Dark",
        "path": "themes/github-dark.json"
      }
    ],
    "terminalThemes": [
      {
        "id": "github-dark",
        "title": "GitHub Dark",
        "path": "terminal/github-dark.json"
      }
    ]
  },
  "capabilities": [],
  "cover": {
    "path": "images/cover.png",
    "alt": "GitHub Dark theme preview with a file tree, syntax-highlighted TypeScript, terminal output, and palette swatches"
  }
}
