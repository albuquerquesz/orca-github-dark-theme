{
  "base": "dark",
  "tokens": {
    "--background": "#1e1e1e",
    "--editor-surface": "#1e1e1e",
    "--foreground": "#e6e6e6",
    "--card": "#262626",
    "--card-foreground": "#e6e6e6",
    "--popover": "#2c2c2c",
    "--popover-foreground": "#e6e6e6",
    "--primary": "#1f6feb",
    "--primary-foreground": "#ffffff",
    "--secondary": "#333333",
    "--secondary-foreground": "#e6e6e6",
    "--muted": "#262626",
    "--muted-foreground": "#9e9e9e",
    "--accent": "#404040",
    "--accent-foreground": "#e6e6e6",
    "--border": "#3a3a3a",
    "--input": "#3a3a3a",
    "--ring": "#1f6feb",
    "--sidebar": "#262626",
    "--sidebar-foreground": "#e6e6e6",
    "--sidebar-accent": "#404040",
    "--sidebar-accent-foreground": "#e6e6e6",
    "--sidebar-border": "#3a3a3a",
    "--sidebar-ring": "#1f6feb",
    "--chat-user-message": "#333333",
    "--text-link": "#58a6ff",
    "--diff-added": "#3fb950",
    "--diff-removed": "#ff7b72",
    "--git-decoration-added": "#3fb950",
    "--git-decoration-modified": "#d29922",
    "--git-decoration-deleted": "#ff7b72",
    "--git-decoration-renamed": "#58a6ff",
    "--git-decoration-untracked": "#3fb950",
    "--git-decoration-copied": "#58a6ff",
    "--git-decoration-ignored": "#6e7681"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8b949e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a5d6ff"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#ffa657"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#e6edf3"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7ee787"
      }
    },
    {
      "name": "Attributes and keys",
      "scope": [
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#58a6ff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#58a6ff",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8b949e",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    }
  ]
}
